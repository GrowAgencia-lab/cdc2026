function waNum(t) { let d = String(t).replace(/\D/g, ''); if (d.indexOf('0') === 0) d = '595' + d.slice(1); return d; }

/* ================= ORDEN TENTATIVO ================= */
function prepararOrden(guardado) {
  const vigentes = INSC.filter(i => i.estadoPago !== 'Anulado').map(i => i.id);
  const set = new Set(vigentes);
  ORDEN_GUARDADO = (guardado || []).filter(id => set.has(id));
  const enOrden = new Set(ORDEN_GUARDADO);
  // Nuevas inscripciones (todavía no ubicadas) van al final, en orden de llegada
  const nuevas = INSC.filter(i => set.has(i.id) && !enOrden.has(i.id)).sort((a, b) => fechaNum(a.fecha) - fechaNum(b.fecha)).map(i => i.id);
  ORDEN = ORDEN_GUARDADO.concat(nuevas);
  setDirty(false);
}

function setDirty(v) { dirty = v; $('o-dirty').classList.toggle('hidden', !v); }
window.addEventListener('beforeunload', e => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });

function durSeg(d) {
  const m = String(d || '').match(/(\d+):(\d{1,2})/);
  return m ? Number(m[1]) * 60 + Number(m[2]) : 180;
}
function horaTxt(seg) {
  seg = Math.round(seg);
  const h = Math.floor(seg / 3600) % 24, m = Math.floor(seg / 60) % 60, s = seg % 60;
  return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
}

function calcularHoras() {
  const [hh, mm] = ($('o-inicio').value || '09:00').split(':').map(Number);
  const trans = Number($('o-trans').value || 0);
  let t = hh * 3600 + mm * 60;
  const [th, tm] = ($('o-inicio-tarde').value || '14:00').split(':').map(Number);
  const inicioTarde = th * 3600 + tm * 60;
  let enTarde = false;
  const horas = {};
  ORDEN.forEach(id => {
    const i = INSC.find(x => x.id === id);
    if (!enTarde && i && i.turno === 'Tarde') { enTarde = true; t = Math.max(t, inicioTarde); }
    horas[id] = horaTxt(t);
    t += durSeg(i && i.duracion) + trans;
  });
  return { horas: horas, fin: horaTxt(t) };
}

function conflictos() {
  const sep = Number($('o-sep').value || 0);
  const res = {};
  if (!sep) return res;
  const docs = ORDEN.map(id => { const i = INSC.find(x => x.id === id); return new Set((i ? i.participantes : []).map(p => norm(p.documento) || norm(p.nombre)).filter(Boolean)); });
  for (let a = 0; a < docs.length; a++) {
    for (let b = a + 1; b <= Math.min(a + sep, docs.length - 1); b++) {
      let n = 0; docs[a].forEach(d => { if (docs[b].has(d)) n++; });
      if (n) {
        res[ORDEN[b]] = res[ORDEN[b]] || [];
        res[ORDEN[b]].push({ con: a + 1, n: n, dist: b - a });
      }
    }
  }
  return res;
}

function pintarOrden() {
  const enGuardado = new Set(ORDEN_GUARDADO);
  const { horas, fin } = calcularHoras();
  const conf = conflictos();
  const q = norm($('o-buscar').value);
  const lista = $('o-lista');
  if (!ORDEN.length) { lista.innerHTML = '<div class="vacio">Todavía no hay inscripciones para ordenar</div>'; $('o-resumen').innerHTML = ''; return; }
  lista.innerHTML = ORDEN.map((id, n) => {
    const i = INSC.find(x => x.id === id) || { obra: id, academia: '', participantes: [] };
    const c = conf[id];
    const hit = q && norm([i.obra, i.academia, i.coreografo, i.id, i.modalidad, i.categoria].join(' ')).indexOf(q) > -1;
    return '<div class="o-item' + (c ? ' conflicto' : '') + (q ? (hit ? ' hit' : ' dim') : '') + '" data-id="' + esc(id) + '">' +
      '<span class="handle" title="Arrastrar">⋮⋮</span>' +
      '<input class="o-pos" type="number" min="1" max="' + ORDEN.length + '" value="' + (n + 1) + '" data-id="' + esc(id) + '" title="Escribí el número y Enter para mover"/>' +
      '<span class="o-hora">' + horas[id] + '</span>' +
      '<span class="o-obra"><b>' + chipTurno(i.turno) + ' ' + esc(i.obra) + (enGuardado.has(id) ? '' : ' <span class="chip chip-new">nueva</span>') + (i.estadoPago === 'Pagado' ? '' : ' <span class="chip chip-pend" title="Pago: ' + esc(i.estadoPago) + '">$</span>') + '</b>' +
        '<small>' + esc(i.id) + ' · ' + esc(i.duracion || '—') + ' · ' + esc(i.coreografo || '') + '</small>' +
        (c ? '<span class="aviso-conf">⚠️ ' + c.map(x => x.n + ' bailarín(es) también en N° ' + x.con).join(' · ') + '</span>' : '') + '</span>' +
      '<span class="o-cell" title="' + esc(i.academia) + '">' + esc(i.academia) + '</span>' +
      '<span class="o-cell">' + esc(i.categoria || '') + ' · ' + esc(i.modalidad || '') + '</span>' +
      '<span class="o-cell">' + esc(tipoCorto(i.tipo)) + '</span>' +
      '<span class="o-cant">' + (i.cantidad || '') + '</span>' +
      '<span class="o-btns"><button data-mv="-1" data-id="' + esc(id) + '" title="Subir">↑</button><button data-mv="1" data-id="' + esc(id) + '" title="Bajar">↓</button></span>' +
      '</div>';
  }).join('');
  const nNuevas = ORDEN.filter(id => !enGuardado.has(id)).length;
  $('o-resumen').innerHTML = '<span><b>' + ORDEN.length + '</b> obras en el orden</span><span>Fin estimado: <b>' + fin.slice(0, 5) + '</b></span>' +
    '<span>☀️ Mañana: <b>' + ORDEN.filter(id => (INSC.find(x => x.id === id) || {}).turno === 'Mañana').length + '</b> · 🌙 Tarde: <b>' + ORDEN.filter(id => (INSC.find(x => x.id === id) || {}).turno === 'Tarde').length + '</b></span>' +
    (mezcla() ? '<span style="color:var(--warn)">⚠️ Hay obras de la tarde intercaladas antes de obras de la mañana</span>' : '') +
    (nNuevas ? '<span><b>' + nNuevas + '</b> nueva(s) sin ubicar (al final)</span>' : '') +
    (Object.keys(conf).length ? '<span style="color:var(--warn)"><b style="color:var(--warn)">' + Object.keys(conf).length + '</b> obra(s) con bailarines repetidos muy cerca</span>' : '');

  lista.querySelectorAll('.o-pos').forEach(inp => {
    inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); moverA(inp.dataset.id, Number(inp.value)); } });
    inp.addEventListener('change', () => moverA(inp.dataset.id, Number(inp.value)));
  });
  lista.querySelectorAll('[data-mv]').forEach(b => b.addEventListener('click', () => {
    const i = ORDEN.indexOf(b.dataset.id); moverA(b.dataset.id, i + 1 + Number(b.dataset.mv));
  }));
  activarArrastre();
}

function mezcla() {
  let vioTarde = false;
  for (const id of ORDEN) {
    const t = (INSC.find(x => x.id === id) || {}).turno;
    if (t === 'Tarde') vioTarde = true;
    else if (t === 'Mañana' && vioTarde) return true;
  }
  return false;
}
$('o-agrupar').addEventListener('click', () => {
  const rango = id => { const t = (INSC.find(x => x.id === id) || {}).turno; return t === 'Mañana' ? 0 : t === 'Tarde' ? 1 : 2; };
  const antes = ORDEN.join('|');
  ORDEN = ORDEN.map((id, n) => ({ id, n })).sort((a, b) => rango(a.id) - rango(b.id) || a.n - b.n).map(x => x.id);
  if (ORDEN.join('|') !== antes) { setDirty(true); toast('Agrupado: mañana primero, tarde después'); }
  pintarOrden();
});

function moverA(id, pos) {
  const from = ORDEN.indexOf(id);
  if (from < 0 || !pos) return;
  pos = Math.max(1, Math.min(ORDEN.length, Math.round(pos)));
  if (pos - 1 === from) { pintarOrden(); return; }
  ORDEN.splice(from, 1);
  ORDEN.splice(pos - 1, 0, id);
  setDirty(true);
  pintarOrden();
  const el = $('o-lista').querySelector('[data-id="' + CSS.escape(id) + '"]');
  if (el) { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); el.classList.add('hit'); setTimeout(() => el.classList.remove('hit'), 1200); }
}

function activarArrastre() {
  if (typeof Sortable === 'undefined') return;
  if (sortable) sortable.destroy();
  sortable = Sortable.create($('o-lista'), {
    handle: '.handle', animation: 150, scroll: true, scrollSensitivity: 120, bubbleScroll: true,
    onEnd: ev => {
      if (ev.oldIndex === ev.newIndex) return;
      const [id] = ORDEN.splice(ev.oldIndex, 1);
      ORDEN.splice(ev.newIndex, 0, id);
      setDirty(true);
      pintarOrden();
    }
  });
}

['o-inicio', 'o-inicio-tarde', 'o-trans', 'o-sep'].forEach(id => $(id).addEventListener('input', () => { pintarOrden(); try { localStorage.setItem('cdc_' + id, $(id).value); } catch (e) {} }));
['o-inicio', 'o-inicio-tarde', 'o-trans', 'o-sep'].forEach(id => { try { const v = localStorage.getItem('cdc_' + id); if (v) $(id).value = v; } catch (e) {} });
$('o-buscar').addEventListener('input', () => {
  pintarOrden();
  const first = $('o-lista').querySelector('.o-item.hit');
  if (first) first.scrollIntoView({ block: 'center', behavior: 'smooth' });
});

$('o-guardar').addEventListener('click', async () => {
  const b = $('o-guardar');
  b.disabled = true; b.textContent = 'Guardando…';
  const { horas } = calcularHoras();
  const filas = ORDEN.map(id => {
    const i = INSC.find(x => x.id === id) || {};
    return { id: id, turno: i.turno || '', academia: i.academia, obra: i.obra, categoria: i.categoria, modalidad: i.modalidad + (i.estilo ? ' — ' + i.estilo : ''), tipo: tipoCorto(i.tipo), cantidad: i.cantidad, coreografo: i.coreografo, duracion: i.duracion, hora: horas[id].slice(0, 5) };
  });
  try {
    const j = await apiPost({ accion: 'guardarOrden', clave: CLAVE, filas: filas });
    if (!j.ok) throw new Error(j.error);
    ORDEN_GUARDADO = ORDEN.slice();
    setDirty(false);
    pintarOrden();
    toast('✅ Orden guardado (' + j.total + ' obras) en la hoja "Orden Tentativo"');
  } catch (e) {
    toast('❌ No se pudo guardar: ' + e.message, 6000);
  } finally { b.disabled = false; b.textContent = '💾 Guardar orden'; }
});
</script>
