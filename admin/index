    '<div class="estado-row"><b>Estado de pago:</b><select id="m-estado">' + ['Pendiente', 'Pago parcial', 'Pagado', 'Anulado'].map(e => '<option' + (e === i.estadoPago ? ' selected' : '') + '>' + e + '</option>').join('') + '</select><button class="btn" id="m-guardar-estado">Guardar estado</button></div>' +
