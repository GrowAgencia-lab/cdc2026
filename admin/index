  return '<span class="chip ' + c + '">' + esc(e || 'Pendiente') + '</span>';
}

function pintarInsc() {
  const fturno = $('f-turno').value;
  const q = norm($('f-buscar').value), fa = $('f-acad').value, ft = $('f-tipo').value, fc = $('f-cat').value, fp = $('f-pago').value;
  let rows = INSC.filter(i =>
    (!fturno || i.turno === fturno) && (!fa || i.academia.trim() === fa) && (!ft || tipoCorto(i.tipo) === ft) && (!fc || i.categoria === fc) && (!fp || i.estadoPago === fp) &&
    (!q || norm([i.id, i.obra, i.academia, i.coreografo, i.modalidad, i.director, i.participantes.map(p => p.nombre + ' ' + p.documento).join(' ')].join(' ')).indexOf(q) > -1));
  const k = sortInsc.k;
  rows.sort((a, b) => {
    let va = a[k], vb = b[k];
    if (k === 'fecha') { va = fechaNum(va); vb = fechaNum(vb); }
    return (typeof va === 'number' ? va - vb : String(va).localeCompare(String(vb), 'es')) * sortInsc.dir;
  });
  const cols = [['id', 'ID'], ['fecha', 'Fecha'], ['academia', 'Academia'], ['obra', 'Obra'], ['modalidad', 'Modalidad'], ['categoria', 'Categoría'], ['turno', 'Turno'], ['tipo', 'Tipo'], ['cantidad', 'Cant.'], ['coreografo', 'Coreógrafo/a'], ['duracion', 'Dur.'], ['tipoMusica', 'Música'], ['monto', 'Monto'], ['estadoPago', 'Pago']];
  $('t-insc').innerHTML = '<thead><tr>' + cols.map(c => '<th class="' + (c[0] === 'cantidad' || c[0] === 'monto' ? 'num' : '') + '" data-k="' + c[0] + '">' + c[1] + (sortInsc.k === c[0] ? (sortInsc.dir > 0 ? ' ▲' : ' ▼') : '') + '</th>').join('') + '</tr></thead><tbody>' +
    (rows.length ? rows.map(i => '<tr class="click" data-id="' + esc(i.id) + '">' +
      '<td class="id">' + esc(i.id) + '</td><td class="muted" style="white-space:nowrap">' + esc(i.fecha) + '</td><td>' + esc(i.academia) + '</td>' +
      '<td><b>' + esc(i.obra) + '</b>' + (String(i.compiteCoreo).toUpperCase() === 'SI' ? ' <span class="chip chip-gold" title="Compite por coreografía">★ Coreo</span>' : '') + '</td>' +
      '<td>' + esc(i.modalidad) + (i.estilo ? '<br><span class="muted">' + esc(i.estilo) + '</span>' : '') + '</td><td>' + esc(i.categoria) + '</td><td>' + chipTurno(i.turno) + '</td><td>' + esc(tipoCorto(i.tipo)) + '</td>' +
      '<td class="num">' + i.cantidad + '</td><td>' + esc(i.coreografo) + '</td><td>' + esc(i.duracion) + '</td>' +
      '<td>' + (i.linkMusica ? '<a class="chip chip-gold" href="' + esc(i.linkMusica) + '" target="_blank" rel="noopener" onclick="event.stopPropagation()">🎵 MP3</a>' : '<span class="muted">' + esc(i.tipoMusica) + '</span>') + '</td>' +
      '<td class="num" style="white-space:nowrap">' + gs(i.monto) + (i.comprobante ? '<br><a class="chip chip-gold" href="' + esc(i.comprobante) + '" target="_blank" rel="noopener" onclick="event.stopPropagation()">🧾 Comprobante</a>' : '') + '</td>' +
      '<td>' + chipPago(i.estadoPago) + '</td></tr>').join('')
      : '<tr><td colspan="14" class="vacio">' + (INSC.length ? 'Ninguna inscripción coincide con el filtro' : 'Todavía no hay inscripciones') + '</td></tr>') + '</tbody>';
  $('f-cont').textContent = rows.length + ' de ' + INSC.length + ' · ' + rows.reduce((s, i) => s + i.cantidad, 0) + ' participaciones · ' + gs(rows.reduce((s, i) => s + i.monto, 0));
  $('t-insc').querySelectorAll('th').forEach(th => th.addEventListener('click', () => {
    const k2 = th.dataset.k; sortInsc = { k: k2, dir: sortInsc.k === k2 ? -sortInsc.dir : 1 }; pintarInsc();
  }));
  $('t-insc').querySelectorAll('tr.click').forEach(tr => tr.addEventListener('click', () => abrirDetalle(tr.dataset.id)));
}

function fechaNum(f) {
  const m = String(f || '').match(/(\d{1,2})\/(\d{1,2})\/(\d{4})\s*(\d{1,2})?:?(\d{2})?/);
  return m ? Number(m[3] + m[2].padStart(2, '0') + m[1].padStart(2, '0') + (m[4] || '0').padStart(2, '0') + (m[5] || '00')) : 0;
}

