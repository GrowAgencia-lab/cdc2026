$('btn-refrescar').addEventListener('click', () => {
  if (dirty && !window.confirm('Tenés cambios sin guardar en el orden tentativo. Si actualizás se pierden. ¿Continuar?')) return;
  cargar();
});

async function cargar() {
  $('cargando').classList.remove('hidden');
  ['dash', 'insc', 'orden'].forEach(x => $('tab-' + x).classList.add('hidden'));
  try {
    const j = await apiGet({ accion: 'admin', clave: CLAVE });
    if (!j.ok) {
      if (/contraseña/i.test(j.error || '')) { ss('cdc_admin'); location.reload(); return; }
      throw new Error(j.error);
    }
    DATA = j;
    INSC = j.inscripciones;
    $('btn-sheet').href = j.sheetUrl;
    if (j.evento) $('ev-info').textContent = 'Sede ' + (j.evento.sede || '') + ' · ' + (j.evento.fecha || '');
    prepararOrden(j.orden);
    pintarDash(); llenarFiltros(); pintarInsc(); pintarOrden();
    $('cargando').classList.add('hidden');
    mostrarTab(tabActual);
    $('dash-act').textContent = 'Actualizado ' + new Date().toLocaleTimeString('es-PY', { hour: '2-digit', minute: '2-digit' });
  } catch (e) {
    $('cargando').innerHTML = '❌ No se pudieron cargar los datos: ' + esc(e.message) + '<br><br><button class="btn" onclick="cargar()">Reintentar</button>';
  }
}

/* ================= DASHBOARD ================= */
function contar(arr, fn) {
  const m = {};
  arr.forEach(x => { const k = fn(x) || '—'; m[k] = (m[k] || 0) + 1; });
  return m;
}
function barras(id, mapa, orden, extra) {
  let keys = Object.keys(mapa);
  if (orden) keys.sort((a, b) => { const ia = orden.indexOf(a), ib = orden.indexOf(b); return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib); });
  else keys.sort((a, b) => mapa[b] - mapa[a]);
  const max = Math.max(1, ...keys.map(k => mapa[k]));
  $(id).innerHTML = keys.length ? keys.map(k =>
    '<div class="bar-row"><span class="n" title="' + esc(k) + '">' + esc(k) + '</span><div class="bar-track"><div class="bar-fill" style="width:' + (mapa[k] / max * 100) + '%"></div></div>' +
    '<span class="c">' + mapa[k] + (extra && extra[k] != null ? ' <small>' + extra[k] + '</small>' : '') + '</span></div>').join('')
    : '<div class="vacio">Sin datos todavía</div>';
}

function pintarDash() {
  const act = INSC.filter(i => i.estadoPago !== 'Anulado');
  const participantes = act.reduce((s, i) => s + (i.cantidad || 0), 0);
  const unicos = new Set();
  act.forEach(i => i.participantes.forEach(p => unicos.add(norm(p.documento) || norm(p.nombre))));
  const academias = new Set(act.map(i => norm(i.academia))).size;
  const monto = act.reduce((s, i) => s + i.monto, 0);
  const pagado = act.filter(i => i.estadoPago === 'Pagado').reduce((s, i) => s + i.monto, 0);
  const coreo = act.filter(i => String(i.compiteCoreo).toUpperCase() === 'SI').length;
  const anuladas = INSC.length - act.length;
  const kpi = (l, v, s) => '<div class="kpi"><div class="l">' + l + '</div><div class="v gold-text">' + v + '</div><div class="s">' + (s || '&nbsp;') + '</div></div>';
  $('kpis').innerHTML =
    kpi('Inscripciones', act.length, anuladas ? anuladas + ' anulada(s) no se cuentan' : 'obras inscriptas') +
    kpi('Academias', academias, 'instituciones distintas') +
    kpi('Participaciones', participantes, unicos.size + ' bailarines distintos') +
    kpiTurno('Mañana', act) + kpiTurno('Tarde', act) +
    kpi('Compiten coreografía', coreo, 'premio Mejor Coreógrafo') +
    kpi('Monto total', gs(monto), 'Pagado: ' + gs(pagado)) +
    kpi('Por cobrar', gs(monto - pagado), act.filter(i => i.estadoPago !== 'Pagado').length + ' obras sin pago completo');

  barras('g-tipo', contar(act, i => tipoCorto(i.tipo)), TIPOS_ORDEN);
  barras('g-cat', contar(act, i => i.categoria), CATS_ORDEN);
  barras('g-mod', contar(act, i => i.modalidad));
  const pagos = contar(INSC, i => i.estadoPago);
  const montos = {};
  INSC.forEach(i => montos[i.estadoPago] = (montos[i.estadoPago] || 0) + i.monto);
  const ex = {}; Object.keys(montos).forEach(k => ex[k] = gs(montos[k]));
  barras('g-pago', pagos, ['Pagado', 'Pago parcial', 'Pendiente', 'Anulado'], ex);
  pintarTablaAcad();
}

function kpiTurno(t, act) {
  const n = act.filter(i => i.turno === t).length;
  const cupo = DATA.turnos && DATA.turnos[t] ? DATA.turnos[t].cupo : 0;
  const sub = cupo > 0 ? (n >= cupo ? '🔴 Cupo completo' : 'quedan ' + (cupo - n) + ' de ' + cupo) : 'sin límite de cupo';
  return '<div class="kpi"><div class="l">' + (t === 'Mañana' ? '☀️' : '🌙') + ' Turno ' + t.toLowerCase() + '</div><div class="v gold-text">' + n + (cupo > 0 ? '<small style="font-size:1rem;opacity:.7"> / ' + cupo + '</small>' : '') + '</div><div class="s">' + sub + '</div>' +
    (cupo > 0 ? '<div class="bar-track" style="margin-top:.4rem;position:relative"><div class="bar-fill" style="width:' + Math.min(100, n / cupo * 100) + '%"></div></div>' : '') + '</div>';
}

function pintarTablaAcad() {
  const act = INSC.filter(i => i.estadoPago !== 'Anulado');
  const m = {};
  act.forEach(i => {
    const k = i.academia.trim();
    const a = m[k] = m[k] || { academia: k, obras: 0, part: 0, monto: 0, pagado: 0, Solista: 0, 'Dúo': 0, 'Trío': 0, Cuarteto: 0, 'Grupo Serie A': 0, 'Grupo Serie B': 0, Conjunto: 0 };
    a.obras++; a.part += i.cantidad; a.monto += i.monto; if (i.estadoPago === 'Pagado') a.pagado += i.monto;
    const t = tipoCorto(i.tipo); if (a[t] != null) a[t]++;
  });
  let rows = Object.values(m);
  const k = sortAcad.k;
  rows.sort((a, b) => (typeof a[k] === 'string' ? a[k].localeCompare(b[k], 'es') : a[k] - b[k]) * sortAcad.dir);
  const cols = [['academia', 'Academia'], ['obras', 'Obras'], ['part', 'Partic.'], ['Solista', 'Sol.'], ['Dúo', 'Dúo'], ['Trío', 'Trío'], ['Cuarteto', 'Cuart.'], ['Grupo Serie A', 'G. A'], ['Grupo Serie B', 'G. B'], ['Conjunto', 'Conj.'], ['monto', 'Monto'], ['pagado', 'Pagado']];
  const tot = {}; cols.forEach(c => { if (c[0] !== 'academia') tot[c[0]] = rows.reduce((s, r) => s + r[c[0]], 0); });
  const cel = (c, v) => c === 'academia' ? '<td>' + esc(v) + '</td>' : '<td class="num">' + (c === 'monto' || c === 'pagado' ? gs(v) : (v || '<span class="muted">·</span>')) + '</td>';
  $('t-acad').innerHTML = '<thead><tr>' + cols.map(c => '<th class="' + (c[0] === 'academia' ? '' : 'num') + '" data-k="' + c[0] + '">' + c[1] + (sortAcad.k === c[0] ? (sortAcad.dir > 0 ? ' ▲' : ' ▼') : '') + '</th>').join('') + '</tr></thead>' +
    '<tbody>' + (rows.length ? rows.map(r => '<tr>' + cols.map(c => cel(c[0], r[c[0]])).join('') + '</tr>').join('') : '<tr><td colspan="12" class="vacio">Sin inscripciones todavía</td></tr>') + '</tbody>' +
    (rows.length ? '<tfoot><tr><td>TOTAL · ' + rows.length + ' academias</td>' + cols.slice(1).map(c => '<td class="num">' + (c[0] === 'monto' || c[0] === 'pagado' ? gs(tot[c[0]]) : tot[c[0]]) + '</td>').join('') + '</tr></tfoot>' : '');
  $('t-acad').querySelectorAll('th').forEach(th => th.addEventListener('click', () => {
    const k2 = th.dataset.k; sortAcad = { k: k2, dir: sortAcad.k === k2 ? -sortAcad.dir : (k2 === 'academia' ? 1 : -1) }; pintarTablaAcad();
  }));
}

