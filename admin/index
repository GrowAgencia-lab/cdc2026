    CLAVE = c; ss('cdc_admin', c);
    entrar();
  } catch (err) {
    $('login-err').textContent = err.message === 'Failed to fetch' ? 'No hay conexión con el servidor' : err.message;
  } finally { $('btn-login').disabled = false; $('btn-login').textContent = 'Ingresar'; }
});

