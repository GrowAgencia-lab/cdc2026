  opts('f-cat', CATS_ORDEN, 'Todas las categorías');
}
['f-buscar', 'f-acad', 'f-tipo', 'f-cat', 'f-pago', 'f-turno'].forEach(id => $(id).addEventListener('input', pintarInsc));

