<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Panel Admin — CUP Dance Competition 2026</title>
<meta name="robots" content="noindex,nofollow"/>
<link rel="icon" href="../logo.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0B0A08;--bg2:#14120E;--card:#1A1712;--card2:#221E17;--line:#3A3122;--line2:#5A4A2A;
  --gold:#D4A537;--gold-l:#F5D77A;--gold-d:#8C6418;--txt:#F4EEE1;--txt2:#B9AD92;--muted:#857B67;
  --ok:#4ADE80;--err:#F87171;--warn:#FBBF24;--info:#60A5FA;
  --grad:linear-gradient(135deg,#8C6418 0%,#D4A537 30%,#F5D77A 50%,#D4A537 70%,#8C6418 100%);
  --disp:'Oswald','Arial Narrow',Arial,sans-serif;--body:'Montserrat',system-ui,sans-serif;
}
body{background:var(--bg);color:var(--txt);font-family:var(--body);font-size:14px;line-height:1.5;min-height:100vh}
h1,h2,h3{font-family:var(--disp);letter-spacing:.5px;font-weight:600}
.gold-text{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
button{font-family:inherit;cursor:pointer}
input,select{font-family:inherit}
.hidden{display:none!important}

/* LOGIN */
.login{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem;background:radial-gradient(ellipse at 50% 0,rgba(212,165,55,.2),transparent 60%)}
.login-card{width:100%;max-width:360px;background:var(--card);border:1px solid var(--line2);border-radius:16px;padding:2rem 1.5rem;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.6)}
.login-card img{width:110px;margin-bottom:.6rem;filter:drop-shadow(0 6px 20px rgba(212,165,55,.4))}
.login-card h1{font-size:1.4rem;text-transform:uppercase;margin-bottom:.2rem}
.login-card p{color:var(--txt2);font-size:.82rem;margin-bottom:1.2rem}
.login-card input{width:100%;padding:.75rem .9rem;border-radius:10px;border:1.5px solid var(--line);background:var(--bg2);color:var(--txt);font-size:1rem;margin-bottom:.8rem;text-align:center}
.login-card input:focus{outline:none;border-color:var(--gold)}
.login-err{color:var(--err);font-size:.8rem;min-height:1.2em;margin-bottom:.5rem}

/* BOTONES */
.btn{border:none;border-radius:10px;padding:.6rem 1rem;font-weight:700;font-size:.84rem;background:var(--grad);color:#1A1306;white-space:nowrap}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn-line{border:1.5px solid var(--line2);background:transparent;color:var(--gold-l);border-radius:10px;padding:.55rem .9rem;font-weight:700;font-size:.82rem;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;gap:.35rem}
.btn-line:hover{border-color:var(--gold)}
.btn-block{width:100%;padding:.8rem}

/* TOPBAR */
.top{position:sticky;top:0;z-index:50;background:rgba(11,10,8,.95);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.top-in{max-width:1400px;margin:0 auto;padding:.6rem 1rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:.6rem;margin-right:auto}
.brand img{width:42px;height:42px}
.brand b{font-family:var(--disp);font-size:1.05rem;letter-spacing:.5px;text-transform:uppercase;display:block;line-height:1.1}
.brand span{font-size:.72rem;color:var(--txt2)}
.tabs{display:flex;gap:.3rem;background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:.25rem}
.tab{border:none;background:transparent;color:var(--txt2);padding:.5rem .9rem;border-radius:9px;font-weight:700;font-size:.82rem}
.tab.active{background:var(--grad);color:#1A1306}
.top-actions{display:flex;gap:.4rem;flex-wrap:wrap}
.top::after{content:'';display:block;height:2px;background:var(--grad)}

main{max-width:1400px;margin:0 auto;padding:1.2rem 1rem 4rem}
.sec-title{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem}
.sec-title h2{font-size:1.4rem;text-transform:uppercase}
.sec-title .sub{color:var(--txt2);font-size:.8rem}
.cargando{text-align:center;color:var(--txt2);padding:3rem 1rem}
.spinner{display:inline-block;width:18px;height:18px;border:3px solid rgba(212,165,55,.25);border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;vertical-align:-4px;margin-right:.5rem}
@keyframes spin{to{transform:rotate(360deg)}}

/* PANELES */
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:1rem 1.1rem;min-width:0}
.panel h3{font-size:.95rem;text-transform:uppercase;color:var(--gold-l);margin-bottom:.8rem;display:flex;justify-content:space-between;align-items:baseline;gap:.5rem}
.panel h3 small{font-family:var(--body);font-size:.72rem;color:var(--muted);text-transform:none;letter-spacing:0;font-weight:500}

/* KPIs */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;margin-bottom:1rem}
@media(max-width:800px){.kpis{grid-template-columns:1fr 1fr}}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:.9rem 1rem;position:relative;overflow:hidden}
.kpi::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 100% 0,rgba(212,165,55,.14),transparent 60%)}
.kpi .l{position:relative;font-size:.68rem;text-transform:uppercase;letter-spacing:1.2px;color:var(--txt2);font-weight:700}
.kpi .v{position:relative;font-family:var(--disp);font-size:2rem;font-weight:700;line-height:1.15;font-variant-numeric:tabular-nums}
.kpi .s{position:relative;font-size:.72rem;color:var(--muted)}

.grid-dash{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin-bottom:1rem}
@media(max-width:1000px){.grid-dash{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.grid-dash{grid-template-columns:1fr}}

/* BARRAS */
.bar-row{display:grid;grid-template-columns:minmax(90px,38%) 1fr auto;gap:.6rem;align-items:center;font-size:.8rem;padding:.22rem 0}
.bar-row .n{color:var(--txt);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar-track{height:10px;background:var(--bg2);border-radius:6px;overflow:hidden}
.bar-fill{height:100%;background:var(--grad);border-radius:6px;min-width:2px}
.bar-row .c{font-weight:700;color:var(--gold-l);font-variant-numeric:tabular-nums;min-width:2.2em;text-align:right}
.bar-row .c small{color:var(--muted);font-weight:500}
.vacio{color:var(--muted);text-align:center;padding:1.2rem .5rem;font-size:.85rem}

/* TABLAS */
.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--card)}
table{width:100%;border-collapse:collapse;font-size:.8rem}
th{position:sticky;top:0;background:#000;color:var(--gold-l);text-align:left;font-weight:700;font-size:.7rem;text-transform:uppercase;letter-spacing:.6px;padding:.65rem .6rem;border-bottom:1px solid var(--line2);white-space:nowrap;cursor:pointer;user-select:none}
th.num,td.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
td{padding:.55rem .6rem;border-bottom:1px solid var(--line);vertical-align:top}
tbody tr:hover td{background:rgba(212,165,55,.05)}
tr.click{cursor:pointer}
tfoot td{background:#000;font-weight:700;color:var(--gold-l)}
.id{font-family:ui-monospace,Consolas,monospace;font-size:.72rem;color:var(--txt2);white-space:nowrap}
.muted{color:var(--muted)}

/* CHIPS */
.chip{display:inline-block;padding:.12rem .5rem;border-radius:99px;font-size:.68rem;font-weight:700;white-space:nowrap;border:1px solid transparent}
.chip-pend{background:rgba(251,191,36,.12);color:var(--warn);border-color:rgba(251,191,36,.35)}
.chip-pag{background:rgba(74,222,128,.12);color:var(--ok);border-color:rgba(74,222,128,.35)}
.chip-par{background:rgba(96,165,250,.12);color:var(--info);border-color:rgba(96,165,250,.35)}
.chip-anu{background:rgba(248,113,113,.12);color:var(--err);border-color:rgba(248,113,113,.35)}
.chip-gold{background:rgba(212,165,55,.14);color:var(--gold-l);border-color:var(--line2)}
.chip-man{background:rgba(251,191,36,.10);color:#FCD34D;border-color:rgba(251,191,36,.3)}
.chip-tar{background:rgba(129,140,248,.12);color:#A5B4FC;border-color:rgba(129,140,248,.35)}
.chip-new{background:rgba(96,165,250,.15);color:var(--info)}

/* FILTROS */
.filtros{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.8rem;align-items:center}
.filtros input,.filtros select{padding:.55rem .75rem;border-radius:10px;border:1.5px solid var(--line);background:var(--bg2);color:var(--txt);font-size:.82rem;min-width:0}
.filtros input{flex:1 1 240px}
.filtros select{flex:0 1 190px}
.filtros input:focus,.filtros select:focus{outline:none;border-color:var(--gold)}
.filtros select option{background:var(--card)}
.contador{font-size:.78rem;color:var(--txt2);margin-left:auto}

/* MODAL */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:200;display:flex;align-items:flex-start;justify-content:center;padding:2rem 1rem;overflow-y:auto}
.modal{width:100%;max-width:760px;background:var(--card);border:1px solid var(--line2);border-radius:16px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.7)}
.modal-head{background:#000;padding:1rem 1.2rem;display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;border-bottom:2px solid var(--gold-d)}
.modal-head h3{font-size:1.3rem;text-transform:uppercase}
.modal-head .x{background:none;border:none;color:var(--txt2);font-size:1.4rem;line-height:1}
.modal-body{padding:1.1rem 1.2rem;display:grid;gap:1rem}
.kv{display:grid;grid-template-columns:repeat(2,1fr);gap:.4rem 1.2rem;font-size:.82rem}
@media(max-width:560px){.kv{grid-template-columns:1fr}}
.kv div{display:flex;justify-content:space-between;gap:.8rem;border-bottom:1px dashed var(--line);padding:.25rem 0}
.kv span:first-child{color:var(--txt2)}
.kv span:last-child{font-weight:600;text-align:right;overflow-wrap:anywhere}
.links{display:flex;gap:.5rem;flex-wrap:wrap}
.part-list{list-style:none;display:grid;gap:.3rem;font-size:.82rem}
.part-list li{display:flex;gap:.6rem;align-items:center;background:var(--bg2);border:1px solid var(--line);border-radius:8px;padding:.4rem .6rem}
.part-list .nn{color:var(--muted);font-family:var(--disp);min-width:1.4em}
.part-list .nm{flex:1;font-weight:600}
.estado-row{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
.estado-row select{padding:.5rem .7rem;border-radius:10px;border:1.5px solid var(--line2);background:var(--bg2);color:var(--txt);font-weight:700}

/* ORDEN */
.orden-bar{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:.75rem .9rem;margin-bottom:.8rem;position:sticky;top:70px;z-index:20}
.orden-bar label{font-size:.72rem;color:var(--txt2);font-weight:700;text-transform:uppercase;letter-spacing:.6px;display:flex;align-items:center;gap:.4rem}
.orden-bar input{padding:.45rem .6rem;border-radius:8px;border:1.5px solid var(--line);background:var(--bg2);color:var(--txt);font-size:.85rem}
.orden-bar input[type=number]{width:70px}
.orden-bar input[type=search]{flex:1 1 200px;min-width:0}
.sin-guardar{color:var(--warn);font-weight:700;font-size:.8rem}
.orden-resumen{display:flex;gap:1rem;flex-wrap:wrap;font-size:.78rem;color:var(--txt2);margin-bottom:.6rem}
.orden-resumen b{color:var(--gold-l)}
.orden-list{display:grid;gap:.35rem}
.o-item{display:grid;grid-template-columns:28px 54px 64px minmax(0,1.6fr) minmax(0,1.1fr) minmax(0,1fr) minmax(0,.9fr) 46px auto;gap:.6rem;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.5rem .6rem;font-size:.8rem}
.o-item.dim{opacity:.25}
.o-item.hit{border-color:var(--gold);box-shadow:0 0 0 2px rgba(212,165,55,.25)}
.o-item.conflicto{box-shadow:inset 4px 0 0 var(--warn)}
.o-item.sortable-ghost{opacity:.35;border-style:dashed;border-color:var(--gold)}
.o-item.sortable-chosen{background:var(--card2)}
.handle{cursor:grab;color:var(--muted);font-size:1.1rem;text-align:center;user-select:none;touch-action:none}
.handle:active{cursor:grabbing}
.o-pos{width:54px;padding:.3rem .2rem;border-radius:7px;border:1.5px solid var(--line);background:var(--bg2);color:var(--gold-l);font-family:var(--disp);font-size:1rem;text-align:center;font-weight:700}
.o-pos:focus{outline:none;border-color:var(--gold)}
.o-hora{font-variant-numeric:tabular-nums;color:var(--txt2);font-size:.76rem}
.o-obra b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.o-obra small{color:var(--muted);font-size:.7rem;display:block}
.o-cell{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--txt2)}
.o-cant{text-align:center;font-weight:700;color:var(--gold-l)}
.o-btns{display:flex;gap:.2rem}
.o-btns button{background:var(--bg2);border:1px solid var(--line);color:var(--txt2);border-radius:6px;width:28px;height:28px;font-size:.8rem}
.o-btns button:hover{color:var(--gold-l);border-color:var(--gold)}
.o-head{background:transparent;border:none;font-size:.66rem;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);font-weight:700;padding-top:0;padding-bottom:0}
.aviso-conf{font-size:.7rem;color:var(--warn);display:block}
@media(max-width:900px){
  .o-item{grid-template-columns:24px 50px minmax(0,1fr) auto;row-gap:.2rem}
  .o-hora,.o-cell,.o-cant{display:none}
  .o-head{display:none}
  .orden-bar{position:static}
}

/* TOAST */
.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%) translateY(140px);background:#000;border:1px solid var(--gold);color:var(--txt);padding:.7rem 1.1rem;border-radius:12px;font-size:.85rem;z-index:999;transition:.35s;max-width:calc(100% - 32px)}
.toast.show{transform:translateX(-50%) translateY(0)}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
</head>
<body>

<!-- LOGIN -->
<div class="login" id="login">
  <form class="login-card" id="login-form">
    <img src="../logo.png" alt="CUP Dance Competition"/>
    <h1 class="gold-text">Panel administrativo</h1>
    <p>CUP Dance Competition 2026 · Sede Gran Asunción</p>
    <input type="password" id="clave" placeholder="Contraseña" autocomplete="current-password"/>
    <div class="login-err" id="login-err"></div>
    <button type="submit" class="btn btn-block" id="btn-login">Ingresar</button>
  </form>
</div>

<!-- APP -->
<div id="app" class="hidden">
  <header class="top">
    <div class="top-in">
      <div class="brand">
        <img src="../logo.png" alt=""/>
        <div><b class="gold-text">CUP Dance Competition</b><span id="ev-info">Panel administrativo</span></div>
      </div>
      <nav class="tabs">
        <button class="tab active" data-tab="dash">📊 Dashboard</button>
        <button class="tab" data-tab="insc">📋 Inscripciones</button>
        <button class="tab" data-tab="orden">🔀 Orden tentativo</button>
      </nav>
      <div class="top-actions">
        <button class="btn-line" id="btn-refrescar" title="Traer datos nuevos del Sheet">🔄 Actualizar</button>
        <a class="btn-line" id="btn-sheet" href="#" target="_blank" rel="noopener">📄 Sheet</a>
        <button class="btn-line" id="btn-salir">Salir</button>
      </div>
    </div>
  </header>

  <main>
    <div class="cargando" id="cargando"><span class="spinner"></span>Cargando inscripciones…</div>

    <!-- DASHBOARD -->
    <section id="tab-dash" class="hidden">
      <div class="sec-title"><h2 class="gold-text">Dashboard</h2><span class="sub" id="dash-act"></span></div>
      <div class="kpis" id="kpis"></div>
      <div class="grid-dash">
        <div class="panel"><h3>Por tipo de participación <small>obras</small></h3><div id="g-tipo"></div></div>
        <div class="panel"><h3>Por categoría <small>obras</small></h3><div id="g-cat"></div></div>
        <div class="panel"><h3>Estado de pago <small>obras · monto</small></h3><div id="g-pago"></div></div>
      </div>
      <div class="grid-dash" style="grid-template-columns:1fr 2fr">
        <div class="panel"><h3>Por modalidad <small>obras</small></h3><div id="g-mod"></div></div>
        <div class="panel" style="padding:0;overflow:hidden">
          <h3 style="padding:1rem 1.1rem 0">Por academia <small>clic en el encabezado para ordenar</small></h3>
          <div class="tbl-wrap" style="border:none;border-radius:0;max-height:520px;overflow:auto"><table id="t-acad"></table></div>
        </div>
      </div>
    </section>

    <!-- INSCRIPCIONES -->
    <section id="tab-insc" class="hidden">
      <div class="sec-title"><h2 class="gold-text">Inscripciones</h2><span class="sub">Clic en una fila para ver el detalle, los participantes y los archivos</span></div>
      <div class="filtros">
        <input type="search" id="f-buscar" placeholder="Buscar obra, academia, coreógrafo, ID o participante…"/>
        <select id="f-acad"><option value="">Todas las academias</option></select>
        <select id="f-tipo"><option value="">Todos los tipos</option></select>
        <select id="f-cat"><option value="">Todas las categorías</option></select>
        <select id="f-turno"><option value="">Todos los turnos</option><option>Mañana</option><option>Tarde</option></select>
        <select id="f-pago"><option value="">Todos los pagos</option><option>Pendiente</option><option>Pago parcial</option><option>Pagado</option><option>Anulado</option></select>
        <span class="contador" id="f-cont"></span>
      </div>
      <div class="tbl-wrap"><table id="t-insc"></table></div>
    </section>

    <!-- ORDEN -->
    <section id="tab-orden" class="hidden">
      <div class="sec-title"><h2 class="gold-text">Orden tentativo</h2><span class="sub">Arrastrá desde ⋮⋮, usá ↑ ↓ o escribí el número de posición. Después tocá Guardar.</span></div>
      <div class="orden-bar">
        <label>Inicio <input type="time" id="o-inicio" value="09:00"/></label>
        <label>Inicio tarde <input type="time" id="o-inicio-tarde" value="14:00"/></label>
        <label>Transición <input type="number" id="o-trans" value="20" min="0" max="300"/> seg</label>
        <label>Separación <input type="number" id="o-sep" value="4" min="0" max="30" title="Avisa si un mismo bailarín se repite a menos de esta cantidad de obras"/> obras</label>
        <button class="btn-line" id="o-agrupar" title="Pone todas las de la mañana primero y las de la tarde después, sin cambiar el orden dentro de cada turno">☀️/🌙 Agrupar por turno</button>
        <input type="search" id="o-buscar" placeholder="Buscar en el orden…"/>
        <span class="sin-guardar hidden" id="o-dirty">⚠️ Cambios sin guardar</span>
        <button class="btn" id="o-guardar">💾 Guardar orden</button>
      </div>
      <div class="orden-resumen" id="o-resumen"></div>
      <div class="o-item o-head"><span></span><span>N°</span><span>Hora</span><span>Obra · ID</span><span>Academia</span><span>Categoría · Modalidad</span><span>Tipo</span><span style="text-align:center">Cant.</span><span></span></div>
      <div class="orden-list" id="o-lista"></div>
    </section>
  </main>
</div>

<div id="modal-root"></div>
<div class="toast" id="toast"></div>

<script>
/* 👉 Misma URL que en formulario.js */
const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzyT46Od1IKUY7RYhbDPJDCghj1uiQsZnATwaJGyoGSM2C6X50pn2Y1G5pIlL5Trgih2g/exec';

const TIPOS_ORDEN = ['Solista', 'Dúo', 'Trío', 'Cuarteto', 'Grupo Serie A', 'Grupo Serie B', 'Conjunto'];
const CATS_ORDEN = ['Baby', 'Pre Infantil', 'Infantil', 'Juvenil', 'Mayores', 'Profesional', 'Aficionado'];

let CLAVE = '';
let DATA = null;          // respuesta completa
let INSC = [];            // inscripciones
let ORDEN = [];           // array de ids en orden actual
let ORDEN_GUARDADO = [];  // ids tal como están en el sheet
let dirty = false;
let sortAcad = { k: 'obras', dir: -1 };
let sortInsc = { k: 'fecha', dir: -1 };
let sortable = null;

const $ = id => document.getElementById(id);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const gs = n => 'Gs. ' + Math.round(n || 0).toLocaleString('es-PY').replace(/,/g, '.');
const norm = s => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
const tipoCorto = t => { t = String(t || ''); for (const x of TIPOS_ORDEN) if (t.indexOf(x) === 0) return x; return t || '—'; };
const ss = (k, v) => { try { v === undefined ? sessionStorage.removeItem(k) : sessionStorage.setItem(k, v); } catch (e) {} };
const sg = k => { try { return sessionStorage.getItem(k); } catch (e) { return null; } };

function toast(m, ms) { const t = $('toast'); t.textContent = m; t.classList.add('show'); clearTimeout(toast._t); toast._t = setTimeout(() => t.classList.remove('show'), ms || 3200); }

async function apiGet(p) {
  const r = await fetch(SCRIPT_URL + '?' + new URLSearchParams(Object.assign({}, p, { _ts: Date.now() })), { cache: 'no-store' });
  return r.json();
}
async function apiPost(o) {
  const r = await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify(o) });
  return r.json();
}

/* ================= LOGIN ================= */
$('login-form').addEventListener('submit', async e => {
  e.preventDefault();
  const c = $('clave').value.trim();
  if (!c) return;
  $('btn-login').disabled = true; $('btn-login').textContent = 'Verificando…'; $('login-err').textContent = '';
  try {
    const j = await apiGet({ accion: 'login', clave: c });
